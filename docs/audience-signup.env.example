# Controlled integration only; never prefix these server-only settings with VITE_.
# Hosted Audience OS URL and an exact reviewed immutable newsletter release are required.
AUDIENCE_SIGNUP_CONTROLLED_ENABLED=false
AUDIENCE_INTAKE_URL=
AUDIENCE_INTAKE_TOKEN=
AUDIENCE_RELEASE_ID=
AUDIENCE_CONTROLLED_EMAIL=
AUDIENCE_PAGE_PATH=/newsletter

# Native receiver on the same Netlify website, backed by a separate Neon database.
# Disabled until the dedicated database/migrations/pinned release are prepared.
# Do not point AUDIENCE_DATABASE_URL at the website's legacy DATABASE_URL.
AUDIENCE_DATABASE_URL=
AUDIENCE_WORKSPACE_ID=monolith
AUDIENCE_WEBSITE_ID=
AUDIENCE_SOURCE_ACCOUNT=monolith-website
# AUDIENCE_INTAKE_URL uses the native function's server-only path:
# https://monolithproject.com/.netlify/functions/audience-intake/api/website-capture/WEBSITE_UUID
