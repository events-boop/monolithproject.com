{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3001 HOST=127.0.0.1 NODE_ENV=production node dist/index.js",
      "url": [
        "http://127.0.0.1:3001/",
        "http://127.0.0.1:3001/tickets",
        "http://127.0.0.1:3001/radio",
        "http://127.0.0.1:3001/booking",
        "http://127.0.0.1:3001/partners",
        "http://127.0.0.1:3001/archive"
      ],
      "numberOfRuns": 3
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
