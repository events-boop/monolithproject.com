# Database (Neon Postgres)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Posh webhook & Security
POSH_WEBHOOK_SECRET=
LAYLO_WEBHOOK_SECRET=
SPONSOR_SESSION_SECRET=
SPONSOR_ACCESS_PASSWORD=
SPONSOR_DECK_PATH=
# Required to enable /api/ops/* admin routes. If unset, admin routes return 503 (fail closed) in ALL environments.
OPS_ADMIN_SECRET=

# Resend (Email Delivery)
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=
BOOKING_WEBHOOK_URL=

# Analytics (PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Meta / Campaign Pixels
VITE_META_PIXEL_ID=1049241148606250
VITE_LAKE_PIXEL_ID=1049241148606250
VITE_LAKE_PIXEL_DEV_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_BRAND_PIXEL_ID=166134370742863
META_LAKE_PIXEL_ID=1049241148606250
META_GRAPH_API_VERSION=v21.0
META_CAPI_TEST_EVENT_CODE=

# Outbound Destinations (Ticket & Waitlist links)
# Overrides server/lib/outbound.ts fallbacks
POSH_TICKET_URL=
LAYLO_URL=
OUTBOUND_LAYLO_URL=
OUTBOUND_TICKETS_FEATURED_URL=
# SUN(SETS) July 4 — Posh ticket page URL.
# Also accepted as NEXT_PUBLIC_POSH_SUNSETS_JULY4_URL (alias).
# When unset, /go/tickets/css-jul04 shows a "Tickets coming soon" fallback.
OUTBOUND_TICKETS_CSS_JUL04_URL=
NEXT_PUBLIC_POSH_SUNSETS_JULY4_URL=
# SUN(SETS) August 22 / September 19 — set when official Posh pages are live.
# When unset, these routes show the same clean "Tickets coming soon" fallback.
OUTBOUND_TICKETS_CSS_AUG22_URL=
OUTBOUND_TICKETS_CSS_SEP19_URL=
OUTBOUND_TICKETS_US_S3E3_URL=
OUTBOUND_WAITLIST_GENERAL_URL=
OUTBOUND_LAYLO_SUNSETS_URL=
OUTBOUND_WAITLIST_CHASING_SUNSETS_URL=
OUTBOUND_WAITLIST_SUNSETS_MANYCHAT_URL=
OUTBOUND_WAITLIST_BENCHEK_URL=
OUTBOUND_WAITLIST_UNTOLD_STORY_URL=
# WhatsApp community invite (https://chat.whatsapp.com/...). Falls back to the
# general Laylo waitlist until set. Rotate here when the invite link changes.
OUTBOUND_SOCIAL_WHATSAPP_URL=

# Marketing & Newsletters
LEAD_PROVIDER=disabled # disabled | mailchimp | beehiiv | convertkit | hubspot | brevo | emailoctopus | laylo
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_DC=
BREVO_BYPASS=true # Keep true unless Brevo should actively receive leads.
BREVO_API_KEY=
LAYLO_API_TOKEN=
# LAYLO_API_URL=https://laylo.com/api/graphql
# LAYLO_BYPASS=true

# Airtable lead mirror (optional)
# Keep the website database/CRM as source of truth; Airtable receives a server-side copy.
AIRTABLE_SYNC_ENABLED=false
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE_ID=
# AIRTABLE_LEADS_TABLE_NAME=Leads
# AIRTABLE_API_BASE_URL=https://api.airtable.com/v0

# Internal Ops logic
VITE_ENABLE_MONOLITH_OPS=false
VITE_API_TARGET=http://localhost:5001

# Public site-data API tuning
# Raise SITE_DATA_RATE_LIMIT for controlled load tests instead of editing route source.
SITE_DATA_RATE_LIMIT=600
SITE_DATA_RATE_LIMIT_WINDOW_MS=300000
